{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExamSprintQuiz",
  "version": "3.0.0",
  "identifier": "com.atomboyc.examsprint",
  "build": {
    "frontendDist": "../_dist"
  },
  "app": {
    "windows": [
      {
        "title": "极速刷题宝 · ExamSprint Studio",
        "width": 1240,
        "height": 840,
        "minWidth": 420,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
